# ═══════════════════════════════════════════════════════════
# RestaurantQR — Variables de Entorno
# ═══════════════════════════════════════════════════════════
# Copia este archivo como .env.local y llena los valores reales.
# NUNCA commitear .env.local con valores reales.

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Twilio (WhatsApp automático) ───
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── Línea de atención humana del restaurante ───
# URL completa wa.me — es el número donde atienden pedidos y clientes en vivo
RESTAURANT_WHATSAPP_LINK=https://wa.me/573001234567

# ─── Branding (sin tocar código) ───
NEXT_PUBLIC_BRAND_NAME=Nombre del Negocio
NEXT_PUBLIC_BRAND_SHORT=NR
NEXT_PUBLIC_BRAND_TAGLINE=Programa de Fidelidad
# Etiqueta del staff según tipo de negocio: Mesero (restaurante) | Barbero (barbería)
NEXT_PUBLIC_STAFF_ROLE_LABEL=Mesero

# ─── Cron Jobs ───
CRON_SECRET=your-cron-secret-key

# ─── Webhook Delivery (n8n → nuestra API) ───
WEBHOOK_DELIVERY_SECRET=your-webhook-delivery-secret

# ─── n8n (Crons y Google Contacts) ───
N8N_GOOGLE_CONTACTS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/google-contacts-sync
N8N_BASE_URL=https://n8n.tudominio.me

# ─── Staff QR Scan (autenticación de meseros + QR dinámico) ───
STAFF_JWT_SECRET=your-staff-jwt-secret-min-32-chars-long
STAFF_QR_JWT_SECRET=your-staff-qr-jwt-secret-min-32-chars-long

# ─── Google Maps Review (opcional) ───
NEXT_PUBLIC_GOOGLE_MAPS_REVIEW_URL=https://share.google/XDfNCZIn7QFQaAME9

# ─── LEGACY: Mantener por compatibilidad si ya tenías DELIVERY_PHONE_NUMBER ───
# Si defines RESTAURANT_WHATSAPP_LINK arriba, este se ignora.
# DELIVERY_PHONE_NUMBER=3001234567
